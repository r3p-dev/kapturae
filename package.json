{
	"name": "kapturae",
	"version": "1.0.0",
	"license": "CC-BY-NC-SA-4.0",
	"author": "Muhamad Repiyan Riski <https://github.com/r3p-dev>",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"paraglide": "bun run scripts/compile_paraglide.ts",
		"check": "bun run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
		"check:watch": "bun run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun test tests/unit",
		"test:build": "bun run build && bun test tests/build",
		"test:e2e": "bun run build && playwright test",
		"serve": "bun scripts/serve_build.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^24",
		"@types/pngjs": "^6.0.5",
		"bits-ui": "^2.18.0",
		"cn": "^0.3.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fflate": "^0.8.3",
		"gifenc": "^1.0.3",
		"globals": "^17.6.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remixicon-svelte": "^0.0.5",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
